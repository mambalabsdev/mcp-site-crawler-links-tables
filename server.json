{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-site-crawler-links-tables",
  "description": "Crawl a website for links, file download links, HTML tables as rows, and lists, with no AI",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-site-crawler-links-tables",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-site-crawler-links-tables",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
